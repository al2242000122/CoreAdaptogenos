# Configure only a verified, authorized shop number before enabling the WhatsApp CTA.
VITE_WHATSAPP_NUMBER=

# Public WooCommerce URL. Leave blank to use the local demo catalog.
VITE_WOOCOMMERCE_URL=
# Woo payment method: cod (contraentrega) or bacs (transferencia).
VITE_WOO_PAYMENT_METHOD=cod
# Optional comma-separated HTTPS hosts for payment redirects (for example, a gateway host).
VITE_WOO_ALLOWED_PAYMENT_HOSTS=

# Receptor de pedidos de CoreMushroom: dejar vacío hasta instalar el backend
# autenticado y contar con una pasarela aprobada para el catálogo real.
VITE_COREMUSHROOM_BRIDGE_API=
VITE_COREMUSHROOM_PAYMENT_HOSTS=
